// Rules for app profiles and shared catalogs, also used by local emulator tests.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Students can view the catalog after login. Only console/admin tools manage it.
    match /classSessions/{sessionId} {
      allow read: if request.auth != null;
    }

    match /clubs/{clubId} {
      allow read: if request.auth != null;
    }

    match /events/{eventId} {
      allow read: if request.auth != null;
    }

    match /users/{uid} {
      function ownsProfile() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow get: if ownsProfile();
      allow create: if ownsProfile()
        && request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt', 'lastLoginAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'lastLoginAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.matches('^[^@ ]+@(myci[.])?csuci[.]edu$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;
      allow update: if ownsProfile() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt'])
          && request.resource.data.lastLoginAt == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['myPodClasses', 'myPodClubs'])
          && request.resource.data.myPodClasses is list
          && request.resource.data.myPodClubs is list)
      );
      // Other users' profiles, listing, and deletion are denied by default.
    }
  }
}
